#!/bin/sh
# ==============================================================================
# BusyBox udhcpc Event Handler Script
# Configures IP address, default route, and DNS resolvers on DHCP events
# ==============================================================================

RESOLV_CONF="/etc/resolv.conf"

[ -n "$1" ] || { echo "Error: should be called from udhcpc"; exit 1; }

case "$1" in
    deconfig)
        echo "[udhcpc] Resetting $interface IP..."
        ifconfig $interface 0.0.0.0
        ;;

    renew|bound)
        echo "[udhcpc] Leased IP $ip on $interface"
        ifconfig $interface $ip netmask ${subnet:-255.255.255.0} broadcast ${broadcast:-+}

        if [ -n "$router" ]; then
            echo "[udhcpc] Setting default gateway to $router"
            while route del default gw 0.0.0.0 dev $interface 2>/dev/null; do
                :
            done
            for r in $router; do
                route add default gw $r dev $interface
            done
        fi

        echo "[udhcpc] Writing DNS resolvers to $RESOLV_CONF"
        echo "# Generated by udhcpc for $interface" > $RESOLV_CONF
        [ -n "$domain" ] && echo "search $domain" >> $RESOLV_CONF
        for d in $dns; do
            echo "nameserver $d" >> $RESOLV_CONF
        done
        ;;
esac

exit 0
