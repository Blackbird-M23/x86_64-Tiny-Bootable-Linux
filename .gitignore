# ==============================================================================
# x86_64 Tiny Bootable Linux - .gitignore
# ==============================================================================

# Build artifacts and compiled binaries (generated by build scripts)
build/
bin/

# Linux Kernel source archives and extracted directories
*.tar.xz
*.tar.bz2
*.tar.gz

# Compiled kernel binary
Image
bzImage
vmlinux

# Initramfs binary archives
*.cpio
*.cpio.gz

# Virtual disk images
*.img
*.qcow2
*.raw

# Firmware / EFI binaries
*.fd
*.efi

# Compiled BusyBox binary artifacts
busybox

# OS / Editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
